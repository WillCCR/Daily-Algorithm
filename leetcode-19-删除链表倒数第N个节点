#法1--改为正序，找到删除节点前一个节点
        dummy = ListNode(next = head)
        cur = head
        m = 0
        while cur:
            cur = cur.next
            m += 1
        k = m - n
        p0 = dummy
        for _ in range(k):
            p0 = p0.next
        p0.next = p0.next.next
        return dummy.next

