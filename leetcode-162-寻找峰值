    n = len(nums)
    left = 0 #从0开始
    right = n - 1

    while left < right: #与left的取值对应
        mid = left + (right - left) // 2

        if nums[mid] > nums[mid + 1]:
            # 当前处于下降段，峰值在 mid 或左侧
            right = mid
        else:
            # 当前处于上升段，峰值一定在 mid 右侧
            left = mid + 1

    return left
