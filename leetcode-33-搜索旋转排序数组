#这题和153不同，153有参照能用普通二分法判段两个上升区域，本题则必须通过分类讨论判断两个上升区域

        def is_blue(i: int) -> bool:
            if nums[i] > nums[-1]:
                if target <= nums[-1]:
                    return False
                elif target > nums[-1] and nums[i] < target:
                    return False
                else:
                    return True
            else:
                if nums[i] >= target or target > nums[-1]:
                    return True
                else:
                    return False

        n = len(nums)
        left = -1
        right = n - 1
        while left + 1 < right:
            mid = left + (right - left) // 2
            if is_blue(mid):
                right = mid
            else:
                left = mid
        if nums[right] != target:
            return -1
        return right
