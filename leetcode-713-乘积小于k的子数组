#同向双指针
#掌握公式一个子数组，滑动窗口，从下标r到l的l-r+1长度数组的不重复子数组个数有l-r+1个，子数组都是从左边减去到最后一个
        n = len(nums)
        x = 1
        ans = 0
        left = 0
        for right in range(n):
            x *= nums[right]
            while left <= right and x >= k:
                x /= nums[left]
                left += 1
            ans += right - left + 1
        return ans
